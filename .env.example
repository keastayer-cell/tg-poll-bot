# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата/группы (отрицательное число для групп, например -1001234567890)
CHAT_ID=-1001234567890

# Ваш личный Telegram user_id (можно узнать через @userinfobot)
ADMIN_ID=123456789

# Часовой пояс
TIMEZONE=Europe/Moscow

# Сколько «ДА» нужно набрать для уведомления
YES_THRESHOLD=10

# Текст вопроса в опросе
POLL_QUESTION=Идете?

# Дополнительные администраторы через запятую
EXTRA_ADMIN_IDS=

# Каталог изменяемых данных. В production: /opt/bot_tg/shared
DATA_DIR=

# Имя экземпляра и управление планировщиком
INSTANCE_NAME=prod
ENABLE_SCHEDULER=1

# Логи и внутренние таймауты
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3
ANNOUNCE_TTL_SECONDS=300
POLL_RECONCILE_DELAY_SECONDS=0.5
HEALTHCHECK_INTERVAL_SECONDS=60
