# Stage/test bot config (for local testing)
# Copy to .env.stage and fill real values.

# Token of a separate test bot from @BotFather
BOT_TOKEN=your_stage_bot_token_here

# Test group/chat id (NOT production chat)
CHAT_ID=-1001234567890

# Your Telegram user id
ADMIN_ID=123456789

# Optional extra admins
EXTRA_ADMIN_IDS=

TIMEZONE=Europe/Moscow
YES_THRESHOLD=10
POLL_QUESTION=Идете?

# Stage helpers
INSTANCE_NAME=stage-local
ENABLE_SCHEDULER=0
