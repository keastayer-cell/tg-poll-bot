# Токен бота от @BotFather
BOT_TOKEN=your_bot_token_here

# ID чата/группы (отрицательное число для групп, например -1001234567890)
CHAT_ID=-1001234567890

# Ваш личный Telegram user_id (можно узнать через @userinfobot)
ADMIN_ID=123456789

# Часовой пояс
TIMEZONE=Europe/Moscow

# Сколько «ДА» нужно набрать для уведомления
YES_THRESHOLD=10

# Текст вопроса в опросе
POLL_QUESTION=Идете?
